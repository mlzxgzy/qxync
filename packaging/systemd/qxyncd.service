# qxync 的常驻同步守护（qxyncd）—— **user 单元**，不是 system 单元。
#
# 为什么是 user 单元：qxyncd 是「某个用户的同步客户端」—— 它用 $HOME / $XDG_RUNTIME_DIR，
# 挂出来的 FUSE 挂载点也属于当前用户，还得能读写用户的 ~/.config/qxync 与
# ~/.local/share/qxync。放进 system 单元反而要手工映射用户、家目录与运行目录。
#
# 用法（普通用户即可，**不需要 root**）：
#     systemctl --user enable --now qxyncd     # 登录即启动 + 现在就启动
#     systemctl --user status qxyncd
#     journalctl --user -u qxyncd -f           # 跟日志（daemon 的 stderr 进 journald）
#     systemctl --user reload qxyncd           # ★ 重启同步（推荐：挂载点一秒都不中断）
#     systemctl --user stop qxyncd             # 停（真卸载 FUSE 挂载 + 删 socket/pid）
#
# 想让它**不登录也常驻**（开机就起、注销也不停）：
#     sudo loginctl enable-linger "$USER"
#
# ⚠ 装了本单元之后，就**别再用** `qxync daemon start` / `qxync daemon stop` 管它：
#   那条路是给「没有 systemd 单元」的用法准备的。`qxync daemon stop` 走 IPC 让进程自己退出，
#   systemd 会看到主进程消失 —— 两边同时用只会互相打架。
#   ★ M37 起这条更硬：`Restart=always` 会把「干净退出」也当自动恢复，于是
#   `qxync daemon stop` / GUI 的「停止」= 刚停下就被拉起来（看起来像没停掉）。
#   **要停只用 `systemctl --user stop qxyncd`**（systemd 明确 stop 的不会重启）。
#
# ★ M16：本单元只负责 **default** 连接。多 NAS 的其它连接用模板单元
#   `qxyncd@<link_id>`（`systemctl --user enable --now qxyncd@nas2`，见同目录
#   `qxyncd@.service`）；**不要**再启用 `qxyncd@default`，那会和本单元抢同一个 socket。
#
# ⚠ 没有连接配置时 qxyncd 会「空转待命」（不做事但一直活着），所以这里**不需要**等网络、
#   也不需要等登录 —— 配好连接之后它会自己转入同步，不用重启本服务。

[Unit]
Description=qxync 常驻同步守护（qxyncd）
Documentation=https://github.com/mlzxgzy/qxync
# 没配连接也能起来（空转待命），所以只依赖最基础的目标
After=default.target
# ★ M37：重启**永不放弃**。默认 `StartLimitBurst=5` + `10s` 的语义是「短时间连续失败
#   够 5 次就躺平」—— 日志里只剩一句 "start request repeated too quickly"，用户看到的
#   还是「服务自己停了、得手动启动」。这里设 0 = 关掉启动频率限制，配合下面的
#   `Restart=always` + `RestartSec=5`：最坏情况也只是每 5 秒一轮**可见**的重试。
#
#   ⚠ 唯一会被拦下的是「已经有别的 daemon 占着 socket」（退出码 3，见
#   `RestartPreventExitStatus=`）：那种情况重启一万次也不会成功，只会刷屏。
StartLimitIntervalSec=0

[Service]
# 前台运行：进程由 systemd 管，**不要**让 daemon 自己 fork（那样 systemd 就看不到它了）
ExecStart=/usr/bin/qxyncd --foreground
# ★ M37：`on-failure` 改成 `always`。
#   真机事故（2026-10-26）：盒盖休眠 2 分钟后唤醒，守护进程被 SIGPIPE 杀死
#   （`code=killed, signal=PIPE`）。而 `systemd.service(5)` 规定 **SIGHUP / SIGINT /
#   SIGTERM / SIGPIPE 被杀都算「干净退出」** ⇒ `Result=success`、`NRestarts=0`，
#   `Restart=on-failure` 永远轮不到重启 —— 进程一直躺到用户手动 start。
#   「信号死亡」不等于「用户主动停」，所以只有 `always` 能兜住这类死亡。
#   休眠/唤醒、断网、OOM 都必须无条件拉起来。
#
#   ★ 语义变化：`qxync daemon stop`（IPC，干净退出 0）和 GUI 的「停止」也会被拉回来。
#   装了本单元之后只用 `systemctl --user stop|start|restart|reload qxyncd` 管它。
Restart=always
RestartSec=5
# ★ M37：直接重启，不走「stop 旧单元 → 等它退出」。
#   本守护收到 SIGTERM 会转「挂载守护模式」不肯退（见下面 TimeoutStopSec 的说明），
#   普通重启要白等 30s 再 SIGKILL；`direct` 让**自动重启**不等这一段。
#   ⚠ 它**不管**显式 `systemctl restart|stop`：那两条仍走 stop 阶段（M15/T6 的已知
#   代价，要秒级重启请用 `systemctl --user reload` = SIGHUP）。
#   （systemd < 254 不认识这个键，只会打一条 warning，不影响 Restart=always。）
RestartMode=direct
# ★ M37：「已经有 daemon 占着 socket」= 退出码 3（`crates/qxync-daemon/src/daemon.rs`
#   的 `EXIT_ALREADY_RUNNING`）。这不是启动失败，重启也不会变好（典型场景：你用
#   `qxync daemon start` 或 GUI 拉了一个不受 systemd 管的 daemon）—— 别重试。
RestartPreventExitStatus=3

# ★ M15/T6：reload = SIGHUP = **重载同步引擎（poller / 脱水 / 队列 / journal /
#   会话保活），完全不碰 FUSE 会话**。reload 不终止进程，所以挂载点一秒都不中断。
#   —— 「我想让同步重新跑起来」请用这条，别用 restart。
ExecReload=/bin/kill -HUP $MAINPID

# ★ M15/T6：`systemctl --user stop/restart` 发的是 SIGTERM，qxyncd 收到后
#   **不再卸载 FUSE 挂载点**，而是「停同步、保留挂载」并留在挂载守护模式里继续
#   应答内核（`ls` / `ls -l` / 读已下载的文件都还正常，见 docs/M15 附录 A.3）。
#
#   ⚠ **但 restart 仍会短暂断开挂载点，这是 systemd 的语义限制，不是 qxync 的问题**：
#   restart 的流程是「stop 旧进程 → **等它退出** → start 新进程」，而守护进程
#   按设计不会在 SIGTERM 后立刻退出，于是 stop 阶段会一直等到下面这个
#   TimeoutStopSec，然后被 SIGKILL 杀掉 —— 挂载点照样断（被强杀，不是正常卸载）。
#   断掉之后由 T5 的「启动自动重挂」恢复（mounts.json 记着现场）。
#
#   TimeoutStopSec 给到 30s：留出「停同步 + 写盘 + 把没发完的上传/删除排空」的余量。
TimeoutStopSec=30
# SIGTERM 只发给主进程，超时后 cgroup 里剩下的才 SIGKILL
KillMode=mixed

[Install]
WantedBy=default.target
