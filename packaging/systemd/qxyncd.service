# qxync 的常驻同步守护（qxyncd）—— **user 单元**，不是 system 单元。
#
# 为什么是 user 单元：qxyncd 是「某个用户的同步客户端」—— 它用 $HOME / $XDG_RUNTIME_DIR，
# 挂出来的 FUSE 挂载点也属于当前用户，还得能读写用户的 ~/.config/qxync 与
# ~/.local/share/qxync。放进 system 单元反而要手工映射用户、家目录与运行目录。
#
# 用法（普通用户即可，**不需要 root**）：
#     systemctl --user enable --now qxyncd     # 登录即启动 + 现在就启动
#     systemctl --user status qxyncd
#     journalctl --user -u qxyncd -f           # 跟日志（daemon 的 stderr 进 journald）
#     systemctl --user reload qxyncd           # ★ 重启同步（推荐：挂载点一秒都不中断）
#     systemctl --user stop qxyncd             # 停（真卸载 FUSE 挂载 + 删 socket/pid）
#
# 想让它**不登录也常驻**（开机就起、注销也不停）：
#     sudo loginctl enable-linger "$USER"
#
# ⚠ 装了本单元之后，就**别再用** `qxync daemon start` / `qxync daemon stop` 管它：
#   那条路是给「没有 systemd 单元」的用法准备的。`qxync daemon stop` 走 IPC 让进程自己退出，
#   systemd 会看到主进程消失 —— 两边同时用只会互相打架（日志里会出现反复重启）。
#
# ⚠ 没有连接配置时 qxyncd 会「空转待命」（不做事但一直活着），所以这里**不需要**等网络、
#   也不需要等登录 —— 配好连接之后它会自己转入同步，不用重启本服务。

[Unit]
Description=qxync 常驻同步守护（qxyncd）
Documentation=https://github.com/mlzxgzy/qxync
# 没配连接也能起来（空转待命），所以只依赖最基础的目标
After=default.target

[Service]
# 前台运行：进程由 systemd 管，**不要**让 daemon 自己 fork（那样 systemd 就看不到它了）
ExecStart=/usr/bin/qxyncd --foreground
# 崩溃/被 OOM 杀掉才拉起；`systemctl stop` 是干净退出（exit 0）→ 不重启
Restart=on-failure
RestartSec=3

# ★ M15/T6：reload = SIGHUP = **重载同步引擎（poller / 脱水 / 队列 / journal /
#   会话保活），完全不碰 FUSE 会话**。reload 不终止进程，所以挂载点一秒都不中断。
#   —— 「我想让同步重新跑起来」请用这条，别用 restart。
ExecReload=/bin/kill -HUP $MAINPID

# ★ M15/T6：`systemctl --user stop/restart` 发的是 SIGTERM，qxyncd 收到后
#   **不再卸载 FUSE 挂载点**，而是「停同步、保留挂载」并留在挂载守护模式里继续
#   应答内核（`ls` / `ls -l` / 读已下载的文件都还正常，见 docs/M15 附录 A.3）。
#
#   ⚠ **但 restart 仍会短暂断开挂载点，这是 systemd 的语义限制，不是 qxync 的问题**：
#   restart 的流程是「stop 旧进程 → **等它退出** → start 新进程」，而守护进程
#   按设计不会在 SIGTERM 后立刻退出，于是 stop 阶段会一直等到下面这个
#   TimeoutStopSec，然后被 SIGKILL 杀掉 —— 挂载点照样断（被强杀，不是正常卸载）。
#   断掉之后由 T5 的「启动自动重挂」恢复（mounts.json 记着现场）。
#
#   TimeoutStopSec 给到 30s：留出「停同步 + 写盘 + 把没发完的上传/删除排空」的余量。
TimeoutStopSec=30
# SIGTERM 只发给主进程，超时后 cgroup 里剩下的才 SIGKILL
KillMode=mixed

[Install]
WantedBy=default.target
