{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qxync",
  "version": "0.5.1",
  "identifier": "org.qxync.qxync-gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "qxync — QNAP 按需同步",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "QNAP Qsync 按需同步客户端",
    "longDescription": "qxync —— FUSE 按需同步 + 常驻守护 qxyncd 的桌面界面（登录配置 / 挂载管理 / 状态面板 / pin 管理）。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
